---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/feed/NoteCard.astro';
import { loadFeed } from '../../lib/load-feed';
import { noteTitle, tiltFor } from '../../lib/feed';
import { formatLong } from '../../lib/time';

export const getStaticPaths = (async () => {
  const { items } = await loadFeed(); // drafts already removed in production
  return items.filter((i) => i.type === 'note').map((item) => ({ params: { id: item.href.split('/')[2] }, props: { item } }));
}) satisfies GetStaticPaths;

const { item } = Astro.props;
const title = noteTitle(item.body ?? '');
---
<BaseLayout title={title} description={title}>
  <div class="container permalink">
    <a class="back f-hand" href="/">← 回到 Feed</a>
    <h1 class="sr-only">碎碎念 · {formatLong(item.date)}</h1>
    <div class="permalink__card"><NoteCard item={item} tilt={tiltFor(item.id)} large /></div>
  </div>
</BaseLayout>
<style>
  .permalink { max-width: 760px; padding-top: 24px; padding-bottom: 96px; }
  .back { display: inline-flex; align-items: center; min-height: 44px; font-size: 26px; font-weight: 700; color: var(--marker); text-decoration: none; }
  .permalink__card { margin-top: 40px; }
</style>
