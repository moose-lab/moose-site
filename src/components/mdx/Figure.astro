---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Polaroid from '../doodle/Polaroid.astro';
interface Props { src: ImageMetadata; alt: string; caption?: string }
const { src, alt, caption } = Astro.props;
---
<div class="mdx-figure"><Polaroid caption={caption} rotate={-1}><Image src={src} alt={alt} widths={[480, 720, 1080]} sizes="(max-width: 760px) 100vw, 720px" /></Polaroid></div>
<style>.mdx-figure { margin: 40px 0; }</style>
